NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# URI-encode username/password in this host URL. Compose uses separate ENGINE_DB_* inputs.
DATABASE_URL=postgresql://engine:REPLACE_WITH_URI_ENCODED_PASSWORD@127.0.0.1:5433/engine_db
REDIS_URL=redis://127.0.0.1:6379
# Optional for foundation startup; required for internal catalog HTTP. Generate separately from JWT secrets.
# INTERNAL_API_TOKEN=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
# Optional as a group for non-streaming startup. SSE requires the gateway's matching
# access-token settings; never use the internal API token as the JWT secret.
# JWT_ACCESS_SECRET=REPLACE_WITH_GATEWAY_BASE64_OF_32_RANDOM_BYTES
# JWT_ACCESS_TTL=900
# JWT_ISSUER=escape-room-api
# JWT_AUDIENCE=escape-room-client
# CORS_ORIGINS=http://localhost:5173
# Standalone/Compose has no injected transport: health reports projection.live=false.
# Opt-in SQL worker; disabled mode and explicit injected executors need no Kubernetes.
SANDBOX_ENABLED=false
SANDBOX_RUNTIME_CLASS=runc
SANDBOX_WORKER_CONCURRENCY=2
# Required for enabled local execution; never use an arbitrary current context.
# SANDBOX_KUBE_CONTEXT=kind-skillbreak-local
# KUBECONFIG=/absolute/path/to/ignored/local/kubeconfig
# SANDBOX_IMAGE_ALLOWLIST=localhost:5001/room1-sql
# Local runc is development-only. Enabled startup requires a published digest-pinned
# SQL template and successful actual isolation preflight. See the SQL quickstart.
# Production Kata deployment/certification, Azure and the periodic janitor are deferred.
