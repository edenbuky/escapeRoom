{
  "name": "@team5/game-engine",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./bootstrap": { "types": "./dist/bootstrap.d.ts", "default": "./dist/bootstrap.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "test": "jest --config jest.config.cjs",
    "test:catalog:integration": "RUN_CATALOG_DB_TESTS=1 jest --config jest.config.cjs --runInBand --runTestsByPath test/catalog.integration.test.ts",
    "test:engine:integration": "RUN_ENGINE_DB_TESTS=1 jest --config jest.config.cjs --runInBand --runTestsByPath test/engine.integration.test.ts",
    "test:projection:integration": "RUN_PROJECTION_DB_TESTS=1 jest --config jest.config.cjs --runInBand --runTestsByPath test/projection.integration.test.ts",
    "test:sandbox:db": "RUN_SANDBOX_DB_TESTS=1 jest --config jest.config.cjs --runInBand --runTestsByPath test/sandbox-db.integration.test.ts test/sandbox-worker.test.ts test/sandbox-catalog.test.ts test/sandbox-executor.test.ts test/sandbox-engine.test.ts test/sandbox-destroy.test.ts",
    "test:sandbox:runtime": "RUN_SANDBOX_RUNTIME_TESTS=1 node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand --runTestsByPath test/sandbox-runtime.integration.test.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "seed:room1": "ts-node src/modules/script-catalog/seed.ts",
    "seed:room1:sql": "ts-node src/modules/script-catalog/publish-sql-room1.ts"
  },
  "dependencies": {
    "@kubernetes/client-node": "1.4.0",
    "@nestjs/common": "^10.4.20",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/typeorm": "^10.0.2",
    "@team5/contracts": "0.1.0",
    "@team5/messaging": "0.1.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "pgsql-ast-parser": "^12.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5"
  }
}
