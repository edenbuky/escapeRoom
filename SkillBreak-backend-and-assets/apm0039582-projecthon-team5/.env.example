NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=escape
DB_PASSWORD=REPLACE_WITH_LOCAL_RANDOM_PASSWORD
DB_NAME=escape_room
DB_SSL=false
JWT_ACCESS_SECRET=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
JWT_ACCESS_TTL=900
JWT_ISSUER=escape-room-api
JWT_AUDIENCE=escape-room-client
REFRESH_TOKEN_TTL_DAYS=7
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_15_TO_128_CHARACTER_PASSWORD

# Independent engine database. Raw credentials are encoded by engine configuration.
ENGINE_DB_USER=engine
ENGINE_DB_PASSWORD=REPLACE_WITH_SEPARATE_LOCAL_RANDOM_PASSWORD
ENGINE_DB_NAME=engine_db
# Required for internal catalog/owner HTTP; use a separate random token, never the JWT secret.
# INTERNAL_API_TOKEN=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
ENGINE_INTERNAL_URL=http://127.0.0.1:3001
# Exact comma-separated browser origins; empty disables cross-origin access.
CORS_ORIGINS=
# Optional: standalone defaults to false in production; local Compose defaults to true.
# SWAGGER_ENABLED=true
# Optional absolute path to your private npm user configuration (never its contents).
# NPM_USER_CONFIG=/absolute/path/to/your/.npmrc